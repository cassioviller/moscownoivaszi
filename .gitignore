# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Playwright E2E
e2e/.results/
e2e/.auth/
e2e/.state.json
test-results/
playwright-report/

# Dumps de backup do sistema (E30) — o registro fica no banco, os arquivos não versionam
backups/
.migration-backup/

# Capturas de tela das rodadas de revisão ficam fora do git (7,5 MB por rodada)
docs/revisao/*/capturas/**/*.png

# Material bruto de evidência na raiz — o zip das 29 fotos do caderno legado é
# o ORIGINAL do que já está versionado em `docs/revisao/*/fotos/` (mesma soma de
# bytes, conferida). Ele entrou por engano num `git add -A` (S37, `85d5108`) e
# saiu em seguida: evidência versiona uma vez, na forma que se lê.
/*.zip

# Derivado de `scripts/prints-dos-manuais.ts`: o manual com os prints em base64
# (5 MB). O PDF e os PNGs são versionados; esta cópia HTML é só para publicar.
docs/manuais/pdf/*.html
